# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL — leave empty to use in-memory store locally
DATABASE_URL=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://africateampay.vercel.app

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_PASSWORD=your-admin-password-here
ADMIN_TOKEN=your-admin-token-here

# ── Coach contact ─────────────────────────────────────────────────────────────
# COACH_MOMO_NUMBER is no longer shown in UI — kept for internal reference only
COACH_MOMO_NUMBER=your-mtn-momo-number
COACH_WHATSAPP=256784277664
NEXT_PUBLIC_COACH_WHATSAPP=256784277664

# ── Telegram notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=378061184

# ── Rates cache ───────────────────────────────────────────────────────────────
RATES_CACHE_MINUTES=10

# ── Email receipts (Gmail — use an App Password, not your main password) ─────
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password-here

# ── USDT wallet addresses (set in Vercel dashboard — never hardcode) ──────────
# TRC20 is the recommended chain ($0.01 fee)
WALLET_TRC20=
WALLET_BEP20=
WALLET_POLYGON=
WALLET_ERC20=
WALLET_SOLANA=
WALLET_BASE=
